# ============================================
# AWS Configuration
# ============================================

# AWS Region where your SQS queue is located
# Examples: us-east-1, eu-west-1, ap-southeast-1
AWS_REGION=us-east-1

# AWS Access Key ID for authentication
# Get this from AWS IAM Console
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS Secret Access Key for authentication
# Keep this secure and never commit to version control
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: AWS Session Token (only if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token

# Optional: AWS endpoint URL (for RusticMQ/ElasticMQ/LocalStack local testing)
# AWS_ENDPOINT_URL=http://localhost:4566

# ============================================
# SQS Configuration
# ============================================

# Optional: override the AWS_* credentials/region/endpoint above for SQS only.
# Useful when SQS lives in a different account/region than S3, or when using
# RusticMQ locally while S3 points at real AWS.
# SQS_REGION=us-east-1
# SQS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# SQS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# SQS_ENDPOINT_URL=http://localhost:9324

# Input Queue - Messages to be sent to WhatsApp (required)
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
INPUT_QUEUE=https://sqs.us-east-1.amazonaws.com/123456789012/input-queue

# Output Queue - Messages received from WhatsApp (required)
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
OUTPUT_QUEUE=https://sqs.us-east-1.amazonaws.com/123456789012/output-queue

# FIFO queues are auto-detected: if "fifo" appears anywhere in INPUT_QUEUE
# or OUTPUT_QUEUE (case-insensitive - the standard convention is a ".fifo"
# suffix, e.g. INPUT_QUEUE=.../input-queue.fifo), MessageGroupId and
# MessageDeduplicationId are added automatically on every send - no extra
# config needed here. See README for how the group id is chosen.

# ============================================
# HTTP Input Endpoint (optional, additive to the SQS input queue)
# ============================================

# When PORT is set, an HTTP endpoint is started alongside the SQS input
# queue poller (it does not replace it) - POST the same command JSON you
# would send to INPUT_QUEUE to http://<host>:<port>/commands instead.
# PORT=3000

# Optional: bind address for the HTTP endpoint
# Default: 0.0.0.0
# HTTP_HOST=0.0.0.0

# Required in production: bearer token clients must send as
# "Authorization: Bearer <AUTH_TOKEN>". Without it the endpoint accepts
# unauthenticated requests - do not expose it publicly in that case.
# AUTH_TOKEN=change_me_to_a_long_random_value

# ============================================
# Baileys/WhatsApp Configuration
# ============================================

# Folder holding the session: the SQLite file auth.sqlite3 (credentials, keys
# and the disappearing-messages cache, plus its -wal/-shm files while running).
# It is created automatically and should be persisted between container
# restarts to avoid re-authentication. A session the TypeScript connector left
# here (creds.json, key files and ephemeral-cache.json) is imported on first
# start, so the TypeScript connector's SESSION_DIR works unchanged.
# Default: ./auth
SESSION_DIR=./auth_info_baileys

# Optional: the session's file itself, overriding SESSION_DIR (--session-db on
# the command line overrides both). ":memory:" keeps the session in memory only
# (a new pairing on every start).
# SESSION_DB=./auth_info_baileys/auth.sqlite3

# Optional: link with a pairing code instead of scanning the QR code.
# PHONE_NUMBER is the account's number, digits only, with country code.
# USE_PAIRING_CODE=true
# PHONE_NUMBER=4915112345678

# Optional: WhatsApp Web socket URL override
# SOCKET_URL=wss://web.whatsapp.com/ws/chat

# Optional: S3-compatible storage configuration for incoming media attachments.
# When S3_BUCKET (and the supporting variables below) are provided, media is
# uploaded to S3 and a presigned URL is returned. Otherwise, media is inlined
# as base64 data.
# S3_* variables override the generic AWS_* ones above for S3 only, so S3 can
# use different credentials/region/endpoint than SQS (e.g. real AWS SQS +
# local MinIO for media).
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000
# S3_BUCKET=baileys-sqs-media
# S3_PREFIX=baileys-sqs/media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_URL_EXPIRATION_SECONDS=604800

# Optional: Specify WhatsApp Web version to use (skips fetching from GitHub)
# Format: JSON array [major, minor, patch] - e.g., [2,3000,1035194821]
# WHATSAPP_VERSION=[2,3000,1035194821]

# ============================================
# Application Configuration
# ============================================

# Log level: trace, debug, info, warn, error, fatal or silent
# Default: debug
# LOG_LEVEL=debug

# Optional: Enable debug logging in listener script
# Set to "true" to see full event payloads
# DEBUG=false
